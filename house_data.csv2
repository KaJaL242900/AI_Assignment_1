# Import libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import LabelEncoder

# Load dataset
df = pd.read_csv('/kaggle/input/house-data/house_data.csv')

# Display dataset
print("First 5 rows:\n", df.head())

# Check null values
print("\nNull values:\n", df.isnull().sum())

# Encode categorical column (location)
le = LabelEncoder()
df['location'] = le.fit_transform(df['location'])

# Features and target
X = df[['area', 'rooms', 'age', 'location']]
y = df['price']

# Train-test split
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2)

# Model
model = LinearRegression()
model.fit(X_train, y_train)

# Predictions
y_pred = model.predict(X_test)

# Output
print("\nPredicted Prices:", y_pred)
print("\nActual Prices:", y_test.values)

# Accuracy (R² Score)
score = model.score(X_test, y_test)
print("\nModel Accuracy:", score)

# Plot
plt.scatter(y_test, y_pred)
plt.xlabel("Actual Price")
plt.ylabel("Predicted Price")
plt.title("Actual vs Predicted Price")
plt.show()